{
  "name": "church-website",
  "version": "0.1.0",
  "private": true,
  "description": "Church website — public site + admin dashboard (HTML5, CSS3, Vanilla JS ES6+, Firebase, Vercel)",
  "type": "module",
  "scripts": {
    "lint": "eslint \"src/**/*.js\" \"functions/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"functions/**/*.js\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:preview": "vercel",
    "deploy:prod": "vercel --prod",
    "bootstrap-admin": "node scripts/bootstrap-admin.cjs",
    "migrate-staging-to-prod": "node scripts/migrate-staging-to-prod.cjs"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "firebase-admin": "^12.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
