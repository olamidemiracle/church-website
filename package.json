{
  "name": "church-website",
  "version": "0.1.0",
  "private": true,
  "description": "Church website — public site + admin dashboard (HTML5, CSS3, Vanilla JS ES6+, Firebase, Vercel)",
  "type": "module",
  "scripts": {
    "lint": "eslint \"src/**/*.js\" \"functions/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"functions/**/*.js\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "vercel dev",
    "deploy:staging": "vercel --env-file=.env.staging",
    "deploy:prod": "vercel --prod"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
