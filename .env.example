# ─────────────────────────────────────────────
# Firebase Web App Config (Auth + Firestore only — no Storage)
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
#
# There is no FIREBASE_STORAGE_BUCKET here on purpose — this project
# does not use Firebase Storage (it now requires the Blaze billing plan
# for any usage). File storage uses Cloudinary instead — see below.
# ─────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────
# Firebase App Check (reCAPTCHA v3 site key)
# Get from: Firebase Console → App Check → Apps → Your web app
# ─────────────────────────────────────────────
APP_CHECK_RECAPTCHA_SITE_KEY=

# ─────────────────────────────────────────────
# Firebase Admin SDK — used ONLY by server-side /api routes
# (set-user-role, delete-media's auth check, scheduled-backup), never by
# the browser. This is the same service account JSON used by
# scripts/bootstrap-admin.cjs, base64-encoded so it survives being
# pasted as a single-line environment variable value.
#
# To generate this value: take your downloaded service account .json
# file and base64-encode its full contents (see SETUP_GUIDE.md Part F.4
# for where to download it, and Part E for the encoding command).
#
# NEVER expose this via api/env.js's public allow-list.
# ─────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─────────────────────────────────────────────
# EmailJS (form submission notifications)
# Get from: emailjs.com → Account → API Keys / Email Services / Templates
# ─────────────────────────────────────────────
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# ─────────────────────────────────────────────
# Paystack (Give / Donate)
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
#
# PAYSTACK_PUBLIC_KEY is safe for client-side use — set it here AND in
# Vercel's environment variables like everything else above.
#
# PAYSTACK_SECRET_KEY is a normal (non-public) Vercel environment
# variable — read directly via process.env inside api/verify-donation.js
# and api/paystack-webhook.js. It is NEVER added to api/env.js's public
# allow-list, so it never reaches the browser. Unlike the project's
# original Firebase Cloud Functions version, there's no separate Secret
# Manager system to configure — Vercel's own environment variables are
# already server-only for anything not explicitly bridged to the client.
# ─────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ─────────────────────────────────────────────
# Cloudinary (file storage — replaces Firebase Storage)
# Get from: cloudinary.com Dashboard (Cloud Name) and Settings → Upload
# (create an unsigned upload preset) for the first two. API Key/Secret
# are under Settings → API Keys.
#
# CLOUDINARY_CLOUD_NAME and CLOUDINARY_UPLOAD_PRESET are safe for
# client-side use (that's what an "unsigned" preset means — see
# SETUP_GUIDE.md for how to configure one with sensible restrictions).
#
# CLOUDINARY_API_KEY and CLOUDINARY_API_SECRET are server-only — used by
# api/delete-media.js and api/scheduled-backup.js for signed operations
# (deleting assets, uploading backup archives) that an unsigned preset
# can't do. NEVER add these two to api/env.js's public allow-list.
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────
# Vercel Cron security — protects api/scheduled-backup.js from being
# triggered by random requests to its public URL. Vercel automatically
# attaches this as a Bearer token on cron-triggered requests once set.
# Generate any long random string for this value.
# ─────────────────────────────────────────────
CRON_SECRET=

# ─────────────────────────────────────────────
# Environment flag — used by services/firebase.js and build tooling
# to know whether it's talking to the staging or prod Firebase project.
# Values: "staging" | "production"
# ─────────────────────────────────────────────
APP_ENV=staging
