# ─────────────────────────────────────────────
# Firebase Web App Config
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
# ─────────────────────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────
# Firebase App Check (reCAPTCHA v3 site key)
# Get from: Firebase Console → App Check → Apps → Your web app
# ─────────────────────────────────────────────
APP_CHECK_RECAPTCHA_SITE_KEY=

# ─────────────────────────────────────────────
# EmailJS (form submission notifications)
# Get from: emailjs.com → Account → API Keys / Email Services / Templates
# ─────────────────────────────────────────────
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# ─────────────────────────────────────────────
# Paystack (Give / Donate)
# Get from: Paystack Dashboard → Settings → API Keys & Webhooks
#
# PAYSTACK_PUBLIC_KEY is safe for client-side use — set it here AND in
# Vercel's environment variables like everything else above.
#
# PAYSTACK_SECRET_KEY is NOT set here, and NOT set in Vercel. It's only
# ever stored in Google Cloud Secret Manager, via:
#   firebase functions:secrets:set PAYSTACK_SECRET_KEY
# It is only read inside functions/paystackWebhook.js and
# functions/verifyDonation.js — never sent to the browser. Leaving this
# line blank is intentional; it's listed here only so it's documented as
# a config value the project depends on.
# ─────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ─────────────────────────────────────────────
# Environment flag — used by services/firebase.js and build tooling
# to know whether it's talking to the staging or prod Firebase project.
# Values: "staging" | "production"
# ─────────────────────────────────────────────
APP_ENV=staging
