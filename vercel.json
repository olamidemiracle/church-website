{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/src/pages/home/index.html" },
    { "source": "/about", "destination": "/src/pages/about/index.html" },
    { "source": "/about/history", "destination": "/src/pages/about/history/index.html" },
    {
      "source": "/about/vision-mission",
      "destination": "/src/pages/about/vision-mission/index.html"
    },
    { "source": "/about/beliefs", "destination": "/src/pages/about/beliefs/index.html" },
    { "source": "/about/leadership", "destination": "/src/pages/about/leadership/index.html" },
    { "source": "/ministries", "destination": "/src/pages/ministries/index.html" },
    { "source": "/ministries/detail", "destination": "/src/pages/ministries/detail/index.html" },
    { "source": "/service-times", "destination": "/src/pages/service-times/index.html" },
    { "source": "/contact", "destination": "/src/pages/contact/index.html" },
    { "source": "/location", "destination": "/src/pages/location/index.html" },
    { "source": "/privacy-policy", "destination": "/src/pages/privacy-policy/index.html" },
    { "source": "/terms", "destination": "/src/pages/terms/index.html" },
    { "source": "/sermons", "destination": "/src/pages/sermons/index.html" },
    { "source": "/sermons/detail", "destination": "/src/pages/sermons/detail/index.html" },
    { "source": "/events", "destination": "/src/pages/events/index.html" },
    { "source": "/events/detail", "destination": "/src/pages/events/detail/index.html" },
    { "source": "/gallery", "destination": "/src/pages/gallery/index.html" },
    { "source": "/gallery/album", "destination": "/src/pages/gallery/album/index.html" },
    { "source": "/news", "destination": "/src/pages/news/index.html" },
    { "source": "/news/detail", "destination": "/src/pages/news/detail/index.html" },
    { "source": "/prayer-request", "destination": "/src/pages/prayer-request/index.html" },
    { "source": "/membership", "destination": "/src/pages/membership/index.html" },
    { "source": "/visit", "destination": "/src/pages/visit/index.html" },
    { "source": "/testimonies", "destination": "/src/pages/testimonies/index.html" },
    { "source": "/give", "destination": "/src/pages/give/index.html" },
    { "source": "/admin/:path*", "destination": "/src/admin/index.html" }
  ],
  "crons": [{ "path": "/api/scheduled-backup", "schedule": "0 3 * * *" }],
  "functions": {
    "api/scheduled-backup.js": { "maxDuration": 60 }
  }
}
