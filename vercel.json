      "destination": "/src/pages/ministries/detail/index"
    },
    {
      "source": "/service-times",
      "destination": "/src/pages/service-times/index"
    },
    {
      "source": "/contact",
      "destination": "/src/pages/contact/index"
    },
    {
      "source": "/location",
      "destination": "/src/pages/location/index"
    },
    {
      "source": "/privacy-policy",
